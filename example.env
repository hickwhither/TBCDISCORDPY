# Bot
BOT_ID=
BOT_TOKEN=
PREFIX=

# Database
DATABASE_URL=sqlite+aiosqlite:///data/tbc.db

# TempVoice (tùy chọn)
TEMP_VOICE_TRIGGER=Create Voice
TEMP_VOICE_ROOM_TEMPLATE={name}'s Room
# URL ảnh thumbnail góc phải của panel (bỏ trống = không hiện ảnh)
TEMP_VOICE_IMAGE=

# Tickets (tùy chọn, mặc định trong ngoặc)
TICKET_STAFF_ROLE=Staff
TICKET_AUTO_CLOSE_HOURS=24
TICKET_WARN_BEFORE_MINUTES=30
TICKET_CHECK_INTERVAL_MINUTES=15
TICKET_MAX_PER_USER=2
LOG_CHANNEL_ID=1546212574230745148

# Birthday (tùy chọn)
# Múi giờ dùng để xác định "hôm nay" cho lời chúc sinh nhật
BIRTHDAY_TIMEZONE=Asia/Ho_Chi_Minh
# Số connhen tặng mỗi sinh nhật trong năm (đặt 0 để tắt quà)
BIRTHDAY_GIFT_CONNHEN=500
